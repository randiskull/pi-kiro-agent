node_modules/
coverage/
*.log
scans/
.DS_Store
.agents/
probes/*.json
.bg-shell/
# Directory-only patterns (a trailing slash) do NOT match a symlink, because git
# classifies a symlink as a file regardless of what it points at. Both of these
# are created as symlinks into the tool's own store -- `.gsd` is a symlink to
# ~/.gsd/projects/<id> -- so `.gsd/` never matched and `git add -A` swept them
# into a commit. Slashless patterns match a file, a directory, or a symlink.
.gsd
.gsd-id
.rpiv
*.bak

# Trace output. PI_KIRO_TRACE records full prompt text and the raw arguments of
# every bridged tool call, so a stray trace in the worktree is a secret leak that
# scripts/secret-scan.mjs cannot catch (it only scans tracked files).
*.jsonl

# Local MCP wiring and env files. `.mcp.json` records server commands and often a
# token; `.env*` is where a kiro credential ends up. `scripts/secret-scan.mjs` only
# scans TRACKED files, so the ignore is what keeps `git add -A` from making one
# trackable in the first place -- the scan cannot be the backstop here.
.mcp.json
.env*
!.env.example

# GSD worktrees. Slashless for the reason given above: it is a real directory today,
# but a directory-only pattern would silently stop matching if it ever became a
# symlink into gsd's own store, which is exactly how `.gsd` got swept into a commit.
.gsd-worktrees
