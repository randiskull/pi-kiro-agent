node_modules/
coverage/
*.log
scans/
.DS_Store
.agents/
probes/*.json
.bg-shell/
# Directory-only patterns (a trailing slash) do NOT match a symlink, because git
# classifies a symlink as a file regardless of what it points at. Both of these
# are created as symlinks into the tool's own store -- `.gsd` is a symlink to
# ~/.gsd/projects/<id> -- so `.gsd/` never matched and `git add -A` swept them
# into a commit. Slashless patterns match a file, a directory, or a symlink.
.gsd
.gsd-id
.gsd-worktrees
.rpiv
*.bak

# Credential and config files. scripts/secret-scan.mjs only scans tracked files
# (git ls-files), so these must be ignored before they can be staged.
.mcp.json
.env*
!.env.example

# Trace output. PI_KIRO_TRACE records full prompt text and the raw arguments of
# every bridged tool call, so a stray trace in the worktree is a secret leak that
# scripts/secret-scan.mjs cannot catch (it only scans tracked files).
*.jsonl
