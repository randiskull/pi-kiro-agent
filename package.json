{
	"name": "pi-kiro-agent",
	"version": "0.2.1",
	"description": "Kiro CLI provider for Pi: delegates turns to your local, authenticated kiro-cli. Seat/credit-billed through the official client, with an MCP bridge that exposes the calling Pi session's tools inside delegated runs.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"kiro",
		"kiro-cli",
		"provider",
		"mcp",
		"acp",
		"delegation",
		"subagents"
	],
	"license": "MIT",
	"author": "Randy James",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/randiskull/pi-kiro-agent.git"
	},
	"homepage": "https://github.com/randiskull/pi-kiro-agent#readme",
	"bugs": {
		"url": "https://github.com/randiskull/pi-kiro-agent/issues"
	},
	"scripts": {
		"test": "vitest run",
		"test:e2e": "vitest run test/extension-load.e2e.test.ts",
		"prepublishOnly": "npm run verify",
		"check": "tsc --noEmit",
		"scan:secrets": "node scripts/secret-scan.mjs --all",
		"scan:kiro": "sh scripts/scan-kiro.sh",
		"verify": "npm run check && npm test && npm run scan:secrets",
		"scan": "npm run verify && npm audit --omit=dev",
		"hooks:install": "git config core.hooksPath scripts/hooks && echo 'pre-push hook installed (core.hooksPath=scripts/hooks)'"
	},
	"files": [
		"src/",
		"docs/",
		"README.md",
		"CHANGELOG.md",
		"CONTRIBUTORS.md",
		"LICENSE"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@types/node": "^26.5.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"protobufjs": "7.6.5"
	}
}
