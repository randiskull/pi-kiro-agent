{
	"name": "pi-kiro",
	"version": "0.2.0",
	"description": "Kiro CLI backend for the Pi coding agent: a `kiro` provider that delegates turns to your local authenticated kiro-cli (seat/credit-billed, official client), with an MCP bridge exposing the calling Pi session's tools inside delegated runs.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"kiro",
		"provider",
		"mcp"
	],
	"license": "MIT",
	"author": "Randy James",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/randiskull/pi-kiro.git"
	},
	"homepage": "https://github.com/randiskull/pi-kiro#readme",
	"bugs": {
		"url": "https://github.com/randiskull/pi-kiro/issues"
	},
	"scripts": {
		"test": "vitest run",
		"check": "tsc --noEmit",
		"scan:secrets": "node scripts/secret-scan.mjs --all",
		"scan:kiro": "sh scripts/scan-kiro.sh",
		"verify": "npm run check && npm test && npm run scan:secrets",
		"scan": "npm run verify && npm audit --omit=dev",
		"hooks:install": "git config core.hooksPath scripts/hooks && echo 'pre-push hook installed (core.hooksPath=scripts/hooks)'"
	},
	"files": [
		"*.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"!*.test.ts",
		"!test-setup.ts",
		"!vitest.config.ts"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@types/node": "^26.4.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"protobufjs": "7.6.5"
	}
}
